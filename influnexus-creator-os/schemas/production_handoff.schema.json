{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://influnexus/creator-os/production_handoff.v10.json",
  "title": "Influnexus production handoff (V10)",
  "type": "object",
  "required": ["schema_version", "date", "slug", "topic", "verification_status", "recording_status", "approved_script",
               "transcript", "storyboard", "source_urls", "visual_asset_requirements", "music", "sound_design",
               "caption_timing", "thumbnail", "output_settings", "editing_hierarchy", "recording_directions"],
  "properties": {
    "schema_version": {"const": "v10"},
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "slug": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "verification_status": {"enum": ["VERIFIED", "BLOCKED"]},
    "verification_report": {"type": ["string", "null"]},
    "recording_status": {"enum": ["AWAITING ORIGINAL RECORDING", "RECORDED", "EDITED", "DELIVERED"]},
    "approved_script": {"type": "string", "minLength": 20},
    "transcript": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["line", "start_s", "end_s"],
      "properties": {"line": {"type": "string"}, "start_s": {"type": "number"}, "end_s": {"type": "number"}}}},
    "storyboard": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["line", "start_s", "end_s", "treatment", "footage", "on_screen_text", "motion_graphics", "transition", "sfx",
                   "source_licensing", "rights"],
      "properties": {"rights": {"enum": ["own", "public-record", "editorial-press", "licensed-library", "own-graphics", "unknown"]}}}},
    "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https?://"}},
    "visual_asset_requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["asset", "rights", "status"],
      "properties": {"status": {"enum": ["to-capture", "to-request", "to-create", "available"]}}}},
    "music": {"type": "object", "required": ["style", "track_suggestion", "licensing", "opening_cue", "ending_cue", "dialogue_music_balance"]},
    "sound_design": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "caption_timing": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["text", "start_s", "end_s"]}},
    "thumbnail": {"type": "object", "required": ["cover_headline", "concept"]},
    "output_settings": {"type": "object", "required": ["resolution", "fps", "color", "codec", "loudness_lufs"],
      "properties": {"resolution": {"const": "2160x3840"}}},
    "editing_hierarchy": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "recording_directions": {"type": "object"}
  }
}
